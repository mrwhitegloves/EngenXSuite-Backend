# Copy this file to ".env" (in this same server folder) and fill in the values. ".env" is git-ignored.
# The server refuses to start if a required value is missing (see config/env.js).
# More variables are added to this file in the phase that needs them.

# ----- Core -----
# development | test | production
NODE_ENV=development
# Port the Express server listens on. Cloud Run sets this itself in production.
PORT=3000
# Public address of the client. In development this is the Vite dev server.
APP_URL=http://localhost:5173
# Production only: the public address of this server (the Cloud Run address), when it differs
# from APP_URL. The browser opens its live-update connection here. Leave empty in development.
REALTIME_URL=
# Production only: number of proxies in front of this server. 1 = Cloud Run alone (the default).
# 2 = the API is reached through the client's host (Vercel) and then Cloud Run.
TRUST_PROXY_HOPS=
# First-run defaults for Settings → Branding. The live values are stored in the database,
# so the product can be renamed later without touching code (decision 0001).
APP_NAME=EngenXSuite
COMPANY_NAME=EngenX
# debug | info | warn | error
LOG_LEVEL=debug

# ----- Database -----
# Production database (required). mongodb+srv://<user>:<password>@<cluster-host>/engenxsuite
MONGODB_URI=
# Development database (recommended). When set, every run that is not NODE_ENV=production uses it,
# so local work and seed data never touch production.
MONGODB_URI_DEV=

# ----- Login -----
# Signs the session cookie. At least 32 random characters; different in production.
SESSION_SECRET=
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# Only accounts on this domain may connect Gmail and Calendar (phase 06).
WORKSPACE_DOMAIN=engenx.in

# ----- File storage (AWS S3) -----
# An IAM user that may only read, write and delete objects in the two buckets below.
AWS_S3_IAM_ACCESS_KEY_ID=
AWS_S3_IAM_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Production uses S3_PROD_BUCKET; every other run uses S3_DEV_BUCKET. Both buckets stay private.
S3_PROD_BUCKET=
S3_DEV_BUCKET=

# ----- Error tracking (Sentry) -----
# DSN of the Node.js project (this server).
SENTRY_BACKEND=
# DSN of the React project. Public by design; the server hands it to the browser app.
SENTRY_CLIENT=

# ----- Plivo phone calls (setup: docs/PLIVO.md) -----
# Plivo console → Account → Auth ID and Auth Token.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Our Plivo number with the country code, for example 918035XXXXXX.
PLIVO_NUMBER=
# The public HTTPS address of this server, so Plivo can reach its webhooks. Production: the
# Cloud Run address (leave empty when REALTIME_URL is set to it). Development: a tunnel address.
API_PUBLIC_URL=

# ----- Meta lead ads (setup: docs/META_LEADS.md) -----
# The Meta app's secret (App settings → Basic). Checks that a webhook really comes from Meta.
META_APP_SECRET=
# Any long random text you make up. Typed once into Meta when the webhook is set up.
META_VERIFY_TOKEN=
# A long-lived Page access token with leads_retrieval and pages_manage_ads. Fetches the answers.
META_PAGE_ACCESS_TOKEN=
# The Graph API version, for example v21.0. Leave empty for the default.
META_GRAPH_VERSION=

# ----- Browser push (notifications when the tab is closed) -----
# A key pair made once with: npx web-push generate-vapid-keys
# Keep the same pair for ever: with a new pair every browser must allow notifications again.
# Optional: without them push is off and everything else works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who runs the server, for the push services: mailto:someone@yourcompany
VAPID_SUBJECT=

# ----- Redis -----
# redis://default:<password>@<host>:<port>  (rediss:// when TLS is on). The app runs without it.
REDIS_URL=

# ----- Seed script only -----
# The first CEO user. The seed creates this user as "invited"; they become active on first sign-in.
SEED_CEO_EMAIL=
