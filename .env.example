# Copy this file to ".env" (in this same server folder) and fill in the values. ".env" is git-ignored.
# The server refuses to start if a required value is missing (see config/env.js).
# More variables are added to this file in the phase that needs them.

# ----- Core -----
# development | test | production
NODE_ENV=development
# Port the Express server listens on. Cloud Run sets this itself in production.
PORT=3000
# Public address of the client. In development this is the Vite dev server.
APP_URL=http://localhost:5173
# First-run defaults for Settings → Branding. The live values are stored in the database,
# so the product can be renamed later without touching code (decision 0001).
APP_NAME=EngenXSuite
COMPANY_NAME=EngenX
# debug | info | warn | error
LOG_LEVEL=debug

# ----- Database -----
# Production database (required). mongodb+srv://<user>:<password>@<cluster-host>/engenxsuite
MONGODB_URI=
# Development database (recommended). When set, every run that is not NODE_ENV=production uses it,
# so local work and seed data never touch production.
MONGODB_URI_DEV=

# ----- Login -----
# Signs the session cookie. At least 32 random characters; different in production.
SESSION_SECRET=
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# Only accounts on this domain may connect Gmail and Calendar (phase 06).
WORKSPACE_DOMAIN=engenx.in

# ----- Seed script only -----
# The first CEO user. The seed creates this user as "invited"; they become active on first sign-in.
SEED_CEO_EMAIL=
